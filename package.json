{
  "name": "pagewise",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @pagewise/web",
    "build": "npm run build -w @pagewise/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check:contrast": "npm run check:contrast -w @pagewise/web"
  },
  "engines": {
    "node": ">=22"
  }
}
