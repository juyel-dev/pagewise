# Copy to .env.local for local development. Never commit real values.

# Google Apps Script web-app URL for waitlist signups (see docs/ops/02-waitlist-apps-script.md)
NEXT_PUBLIC_WAITLIST_URL=

# Canonical site URL (optional on Vercel; used for metadata and Open Graph)
NEXT_PUBLIC_SITE_URL=

# Feature flags (docs/blueprint/01 PLT-7)
NEXT_PUBLIC_APP_OPEN=false
NEXT_PUBLIC_NCERT_FALLBACK=false

# Supabase (add after the PageWise project exists; never commit real values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
